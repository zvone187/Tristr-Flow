# Tristr Flow desktop development settings. Copy this file to .env to override
# the defaults for npm start.
#
# Account service. Set this to a local service when testing an isolated account.
# SPEAK_SERVICE_URL=http://127.0.0.1:3000

# Default voice in the account catalogue.
# SPEAK_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# SPEAK_VOICE_NAME=Rachel

# Global hotkey (Electron accelerator). Modifier-only chords are not supported,
# so this needs a regular key. Defaults: Control+Shift+Space and Control+Alt+D.
# SPEAK_HOTKEY=Control+Shift+Space
# SPEAK_HOTKEY2=Control+Alt+D

# Disable product analytics when testing the account service locally.
# POSTHOG_DISABLED=true
